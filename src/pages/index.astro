---
import { getCollection } from 'astro:content';

import { SITE } from '../config.ts';
import { AILELER, aileRengi } from '../data/aileler.ts';
import { KATEGORI_HARITASI } from '../data/kategoriler.ts';
import Temel from '../layouts/Temel.astro';
import { kelimeSay, okumaDakikasi } from '../lib/okuma.ts';
import { SEVIYE_ADLARI } from '../lib/seviye.ts';
import { kategoriYolu, siteYolu } from '../lib/yol.ts';

const terimler = await getCollection('terimler');

interface KategoriOzeti {
  slug: string;
  ad: string;
  toplam: number;
  yazilmis: number;
}

const ozetler = new Map<string, KategoriOzeti>();
for (const [slug, kategori] of KATEGORI_HARITASI) {
  ozetler.set(slug, { slug, ad: kategori.ad, toplam: 0, yazilmis: 0 });
}

for (const terim of terimler) {
  const ozet = ozetler.get(terim.data.category);
  if (!ozet) continue;
  ozet.toplam += 1;
  if (terim.data.status !== 'stub') ozet.yazilmis += 1;
}

const toplamTerim = terimler.length;
const toplamYazilmis = terimler.filter((t) => t.data.status !== 'stub').length;
const sayi = new Intl.NumberFormat('tr-TR');

/** Öğrenme yolları: aramaya alternatif giriş. Süre terimlerden hesaplanır. */
const terimHaritasi = new Map(terimler.map((terim) => [terim.id, terim]));
const yollar = (await getCollection('yollar'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((yol) => ({
    slug: yol.id,
    baslik: yol.data.title,
    seviye: yol.data.level,
    terimSayisi: yol.data.terms.length,
    dakika: okumaDakikasi(
      yol.data.terms.reduce(
        (toplam, slug) => toplam + kelimeSay(terimHaritasi.get(slug)?.body ?? ''),
        0,
      ),
    ),
  }));
---

<Temel baslik={SITE.name} aktif="kategoriler">
  <div class="giris">
    <h1 class="giris__baslik">Blockchain ve yazılım sözlüğü</h1>
    <p class="giris__ozet">
      Bir terimi ara, iki cümlede ne olduğunu oku, gerekirse derine in. Türkçe
      yazılıyor, topluluk tarafından büyütülüyor.
    </p>
  </div>

  {/* Sayfanın odağı: gerçek girdi, sonuçlar aşağıda aynı sayfada açılır. */}
  <form
    class="arama"
    id="arama-formu"
    role="search"
    autocomplete="off"
    data-indeks-url={siteYolu('/search-index.json')}
    data-terim-tabani={siteYolu('/terim')}
  >
    <label class="sadece-ekran-okuyucu" for="arama-girdisi">Terim ara</label>
    <input
      class="arama__girdi"
      id="arama-girdisi"
      name="q"
      type="search"
      placeholder="terim, kısaltma ya da Türkçe karşılık"
      enterkeyhint="search"
      autofocus
    />
    <p class="arama__ipucu">
      Türkçe karakter kullanmana gerek yok — <b>akilli sozlesme</b> yazarsan{' '}
      <b>Akıllı Sözleşme</b>'yi de bulur. <kbd class="tus">/</kbd> tuşu buraya atlar.
    </p>
  </form>

  {/*
    Kapsam bilgisi tek satır. Eskiden hem burada hem altındaki bildirim
    kutusunda aynı sayı yazıyordu. Metin sunucuda üretiliyor: indeks
    yüklenmeden de doğru, "yükleniyor" titremesi yok. Arama betiği indeks
    hazır olunca aynı cümleyi tazeler, hata olursa yerine hatayı yazar.
  */}
  <p class="arama-durum" id="arama-durumu" role="status" aria-live="polite">
    {sayi.format(toplamTerim)} terim aranabilir.
  </p>

  <ul class="terim-listesi" id="arama-sonuclari" hidden></ul>

  <div id="gozat">
    {
      /* Yazılmamış terim varsa bunu söylemek gerekir; hepsi yazıldığında
         kutu bilgi taşımadan yer kaplar, o yüzden hiç basılmaz. */
      toplamYazilmis < toplamTerim && (
        <div class="bildirim bildirim--notr kapsam">
          <span class="bildirim__baslik">
            {sayi.format(toplamTerim)} terimin {sayi.format(toplamYazilmis)} tanesi
            yazıldı.
          </span>
          <span>
            Geri kalanların adı listede duruyor ama tanımı henüz yok. Bir
            kategoriye girdiğinde hangilerinin yazıldığını görürsün.
          </span>
        </div>
      )
    }

    {/*
      Arama, ne aradığını bilen okur içindir. Bilmeyen okurun buradan bir
      başlangıç noktası bulması gerekir; yollar tam olarak o iş için.
      Ana sayfa kısa kalsın diye altı yolun ilk üçü gösterilir.
    */}
    <section class="aile" style="--family-color: var(--color-accent)">
      <h2 class="aile__baslik">Öğrenme yolları</h2>
      <p class="aile__aciklama">
        Nereden başlayacağını bilmiyorsan sıralı bir yol izle. Her yol bir soruya
        cevap verir ve terimleri öğrenme sırasına dizer.
      </p>

      <ul class="kategori-listesi">
        {
          yollar.slice(0, 3).map((yol) => (
            <li class="kategori-satiri">
              <a class="kategori-satiri__ad" href={siteYolu(`/yollar/${yol.slug}`)}>
                {yol.baslik}
              </a>
              <span class="kategori-satiri__sayi">
                {SEVIYE_ADLARI[yol.seviye]} · {sayi.format(yol.terimSayisi)} terim · ~
                {sayi.format(yol.dakika)} dk
              </span>
            </li>
          ))
        }
      </ul>

      <p class="bolum-baglanti">
        <a href={siteYolu('/yollar')}>
          Altı yolun hepsi
          <span aria-hidden="true"> →</span>
        </a>
      </p>
    </section>

    {
      AILELER.map((aile) => (
        <section class="aile" style={`--family-color: ${aileRengi(aile)}`}>
          <h2 class="aile__baslik">{aile.ad}</h2>
          <p class="aile__aciklama">{aile.aciklama}</p>

          <ul class="kategori-listesi">
            {aile.kategoriler.map((slug) => {
              const ozet = ozetler.get(slug)!;
              return (
                <li class="kategori-satiri">
                  <a class="kategori-satiri__ad" href={kategoriYolu(ozet.slug)}>
                    {ozet.ad}
                  </a>
                  <span class="kategori-satiri__sayi">
                    {sayi.format(ozet.toplam)} terim
                    {ozet.yazilmis > 0
                      ? ` · ${sayi.format(ozet.yazilmis)} yazıldı`
                      : ' · yazım sırada'}
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</Temel>

<script>
  import { aramayiBagla, kisayolBagla } from '../lib/arama-ui.ts';

  const form = document.querySelector<HTMLFormElement>('#arama-formu');
  const girdi = document.querySelector<HTMLInputElement>('#arama-girdisi');
  const durum = document.querySelector<HTMLElement>('#arama-durumu');
  const sonuclar = document.querySelector<HTMLElement>('#arama-sonuclari');
  const gozat = document.querySelector<HTMLElement>('#gozat');

  if (form && girdi && durum && sonuclar) {
    aramayiBagla({ form, girdi, durum, sonuclar, gozat });
    kisayolBagla(girdi);
  }
</script>

<style>
  /* Kesilmiş bir listenin altındaki "devamı" bağlantısı. Liste kabuğunun
     dışında durur ki satırlardan biri sanılmasın. */
  .bolum-baglanti {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
  }
</style>
