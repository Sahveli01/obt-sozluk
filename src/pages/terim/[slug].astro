---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';

import { aileBul, aileRengi } from '../../data/aileler.ts';
import { kategoriBul } from '../../data/kategoriler.ts';
import Temel from '../../layouts/Temel.astro';
import { SEVIYE_ADLARI } from '../../lib/seviye.ts';
import { kategoriYolu, siteYolu, terimYolu } from '../../lib/yol.ts';

export const getStaticPaths = (async () => {
  const terimler = await getCollection('terimler');
  return terimler.map((terim) => ({
    params: { slug: terim.id },
    props: { terim },
  }));
}) satisfies GetStaticPaths;

const { terim } = Astro.props;
const { Content } = await render(terim);

const kategori = kategoriBul(terim.data.category);
const aile = aileBul(terim.data.category);
const stub = terim.data.status === 'stub';

/** İlgili ve anlam ayrımı bağlantıları için gerçek terim adlarını çöz. */
async function baglantilar(sluglar: readonly string[]) {
  const sonuc = [];
  for (const slug of sluglar) {
    const hedef = await getEntry('terimler', slug);
    sonuc.push({
      slug,
      ad: hedef?.data.term ?? slug,
      kisa: hedef?.data.short ?? '',
    });
  }
  return sonuc;
}

const ilgili = await baglantilar(terim.data.related);
const anlamAyrimi = await baglantilar(terim.data.disambiguation);

const tarihBicimi = new Intl.DateTimeFormat('tr-TR', { dateStyle: 'long' });
---

<Temel
  baslik={terim.data.term}
  aciklama={terim.data.short || terim.data.term}
  noindex={stub}
>
  <article class="terim" style={`--family-color: ${aileRengi(aile)}`}>
    <div class="terim__kimlik">
    <nav class="izlek" aria-label="Konum">
      <a href={siteYolu('/')}>Kategoriler</a>
      <span class="izlek__ayrac" aria-hidden="true">/</span>
      {
        kategori && (
          <a href={kategoriYolu(kategori.slug)}>{kategori.ad}</a>
        )
      }
      {
        terim.data.subcategory !== '' && (
          <>
            <span class="izlek__ayrac" aria-hidden="true">
              /
            </span>
            <span>{terim.data.subcategory}</span>
          </>
        )
      }
    </nav>

    <header class="terim__bas">
      <h1 class="terim__ad">{terim.data.term}</h1>
      {terim.data.tr !== '' && <p class="terim__tr">{terim.data.tr}</p>}
      {terim.data.short !== '' && <p class="terim__kisa">{terim.data.short}</p>}

      <div class="satir terim__etiketler">
        <span class="rozet rozet--seviye">{SEVIYE_ADLARI[terim.data.level]}</span>
        {
          terim.data.status === 'taslak' && (
            <span class="rozet rozet--taslak">Taslak</span>
          )
        }
        {
          terim.data.status === 'incelendi' && (
            <span class="rozet rozet--incelendi">İncelendi</span>
          )
        }
      </div>
    </header>
    </div>

    {
      /* "Yazılmadı" bir hata değil, sözlüğün dürüst bir durumu. Kırmızı
         yok, uyarı yok: okurun buradan nereye gidebileceğini söylüyoruz. */
      stub && (
        <div class="bildirim bildirim--notr terim__bos">
          <span class="bildirim__baslik">Bu terim henüz yazılmadı.</span>
          <span>
            Terim sözlüğün listesinde var, tanımı sırada.
            {kategori && (
              <>
                {' '}
                Bu arada{' '}
                <a href={kategoriYolu(kategori.slug)}>{kategori.ad}</a> kategorisindeki
                diğer terimlere bakabilirsin.
              </>
            )}
          </span>
        </div>
      )
    }

    {
      /* Tarihe duyarlı içerik kaynağını ve tarihini göstermek zorunda;
         yoksa rakam uydurulmuş sayılır. */
      terim.data.dateSensitive && !stub && (
        <div class="bildirim bildirim--uyari">
          <span class="bildirim__baslik">Bu tanım zamanla değişebilecek bilgi içeriyor.</span>
          <span>
            İçindeki güncel durum ve rakamlar{' '}
            {tarihBicimi.format(terim.data.updated)} tarihi itibarıyla geçerlidir.
          </span>
        </div>
      )
    }

    {!stub && <div class="okuma"><Content /></div>}

    {
      anlamAyrimi.length > 0 && (
        <section class="bolum">
          <h2 class="bolum__baslik">Aynı adı taşıyan diğer terimler</h2>
          <ul class="terim-listesi">
            {anlamAyrimi.map((hedef) => (
              <li class="terim-satiri">
                <a class="terim-satiri__ad" href={terimYolu(hedef.slug)}>
                  {hedef.ad}
                </a>
                {hedef.kisa !== '' && (
                  <span class="terim-satiri__kisa">{hedef.kisa}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      ilgili.length > 0 && (
        <section class="bolum">
          <h2 class="bolum__baslik">İlgili terimler</h2>
          <ul class="terim-listesi">
            {ilgili.map((hedef) => (
              <li class="terim-satiri">
                <a class="terim-satiri__ad" href={terimYolu(hedef.slug)}>
                  {hedef.ad}
                </a>
                {hedef.kisa !== '' && (
                  <span class="terim-satiri__kisa">{hedef.kisa}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      terim.data.sources.length > 0 && (
        <section class="bolum">
          <h2 class="bolum__baslik">Kaynaklar</h2>
          <ul class="kaynaklar">
            {terim.data.sources.map((kaynak) => (
              <li>
                <a href={kaynak} rel="noreferrer">
                  {kaynak}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <footer class="terim__alt">
      <p>
        Güncellendi: {tarihBicimi.format(terim.data.updated)}
        {
          terim.data.reviewedBy.length > 0 &&
            ` · İnceleyen: ${terim.data.reviewedBy.join(', ')}`
        }
      </p>
    </footer>
  </article>
</Temel>

<style>
  /* Yazı tek sütun ve kabuğun içinde ortalı. Sola yaslı bırakıldığında
     geniş ekranda sayfanın sağ yarısı boş kalıyor, düzen dengesiz
     görünüyordu. */
  .terim {
    max-width: var(--measure);
    margin-inline: auto;
  }

  /* Başlık bölgesi: solunda ailenin renginde şerit, terim adı o renkte.
   * Renk yalnız değil — izlekte kategori adı, başlıkta terimin kendisi var. */
  .terim__kimlik {
    padding-inline-start: var(--space-5);
    border-inline-start: var(--border-accent) solid
      var(--family-color, var(--color-family-fallback));
    margin-bottom: var(--space-6);
  }

  .terim__bas > * + * {
    margin-top: var(--space-3);
  }

  .terim__ad {
    color: var(--family-color, var(--color-text));
    overflow-wrap: anywhere;
  }

  .terim__tr {
    font-size: var(--text-lead);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  /* Tek cümlelik tanım sayfanın en çok okunan satırı: okuma yüzeyinin
   * serifiyle ve gövdeden belirgin biçimde büyük. */
  .terim__kisa {
    font-family: var(--font-reading);
    font-size: var(--text-h3);
    line-height: var(--leading-body);
    color: var(--color-text);
    text-wrap: pretty;
  }

  .terim__etiketler {
    padding-top: var(--space-2);
  }

  @media (min-width: 48rem) {
    .terim__kisa {
      font-size: var(--text-h2);
    }
  }

  .terim__bos,
  .bildirim {
    margin-top: var(--space-5);
  }

  .okuma {
    margin-top: var(--space-5);
  }

  .kaynaklar {
    list-style: none;
    padding: 0;
    font-size: var(--text-small);
  }

  .kaynaklar li + li {
    margin-top: var(--space-2);
  }

  .kaynaklar a {
    overflow-wrap: anywhere;
  }

  .terim__alt {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
</style>
