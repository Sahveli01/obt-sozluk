---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import { aileBul, aileRengi } from '../../data/aileler.ts';
import { KATEGORILER } from '../../data/kategoriler.ts';
import Temel from '../../layouts/Temel.astro';
import { siteYolu, terimYolu } from '../../lib/yol.ts';

export const getStaticPaths = (async () => {
  const terimler = await getCollection('terimler');

  return KATEGORILER.map((kategori) => ({
    params: { slug: kategori.slug },
    props: {
      kategori,
      terimler: terimler
        .filter((terim) => terim.data.category === kategori.slug)
        .sort((a, b) => a.data.term.localeCompare(b.data.term, 'tr')),
    },
  }));
}) satisfies GetStaticPaths;

const { kategori, terimler } = Astro.props;

/** Alt başlıklar taslaktaki sırayla; başlıksızlar en sonda. */
const bloklar = [...kategori.altBasliklar, '']
  .map((altBaslik) => ({
    altBaslik,
    terimler: terimler.filter((terim) => terim.data.subcategory === altBaslik),
  }))
  .filter((blok) => blok.terimler.length > 0);

const yazilmis = terimler.filter((t) => t.data.status !== 'stub').length;
const sayiBicimi = new Intl.NumberFormat('tr-TR');

const aile = aileBul(kategori.slug);
---

<Temel baslik={kategori.ad} aciklama={kategori.aciklama}>
  <div class="kategori-kimlik" style={`--family-color: ${aileRengi(aile)}`}>
    <nav class="izlek" aria-label="Konum">
      <a href={siteYolu('/')}>Kategoriler</a>
      <span class="izlek__ayrac" aria-hidden="true">/</span>
      {aile && <span class="izlek__aile">{aile.ad}</span>}
      <span class="izlek__ayrac" aria-hidden="true">/</span>
      <span>{kategori.ad}</span>
    </nav>

    <div class="sayfa-basi">
      <h1 class="kategori-baslik">{kategori.ad}</h1>
      <p class="sayfa-basi__giris">{kategori.aciklama}</p>
      <p class="kategori-sayi">
        {sayiBicimi.format(terimler.length)} terim
        {yazilmis > 0 && ` · ${sayiBicimi.format(yazilmis)} yazıldı`}
      </p>
    </div>
  </div>

  {
    /* Boş durum gerçek iş ister: bugün okurun ilk gördüğü ekran bu.
       Terim adları listede ama tanımlar henüz yok — bunu söylemek,
       okuru tek tek tıklatıp boş sayfa bulmasına yeğdir. */
    yazilmis === 0 && (
      <div class="bildirim bildirim--notr">
        <span class="bildirim__baslik">Bu kategori henüz yazılmadı.</span>
        <span>
          Terim listesi hazır, tanımlar sırada. Aşağıdaki adlar sözlüğe girecek
          terimlerdir; tanımı yazılanlar bu listede tek cümlelik açıklamalarıyla
          birlikte görünür.
        </span>
      </div>
    )
  }

  {
    bloklar.map((blok) => (
      <section class="bolum">
        {blok.altBaslik !== '' && (
          <h2 class="bolum__baslik">
            {blok.altBaslik}{' '}
            <span class="bolum__sayi">{sayiBicimi.format(blok.terimler.length)}</span>
          </h2>
        )}
        <ul class="terim-listesi">
          {blok.terimler.map((terim) => (
            <li class="terim-satiri">
              <a class="terim-satiri__ad" href={terimYolu(terim.id)}>
                {terim.data.term}
              </a>
              {terim.data.tr !== '' && (
                <span class="terim-satiri__tr">{terim.data.tr}</span>
              )}
              {terim.data.short !== '' && (
                <span class="terim-satiri__kisa">{terim.data.short}</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Temel>

<style>
  /* Başlık bölgesi sayfanın kimliğini taşır: solunda ailenin renginde bir
     şerit, başlıkta aynı renk. Renk yalnız kalmıyor — aile adı izlekte
     yazıyor ve başlığın kendisi zaten okunuyor. */
  .kategori-kimlik {
    padding-inline-start: var(--space-5);
    border-inline-start: var(--border-accent) solid
      var(--family-color, var(--color-family-fallback));
    margin-bottom: var(--space-7);
  }

  .kategori-baslik {
    color: var(--family-color, var(--color-text));
  }

  .izlek__aile {
    color: var(--family-color, var(--color-text-muted));
    font-weight: var(--weight-medium);
  }

  .kategori-sayi {
    color: var(--color-text-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  /* Başlık bloğu kendi alt boşluğunu taşıyor; sayfa-basi'nin kendi
     boşluğu burada çift boşluk yaratırdı. */
  .kategori-kimlik .sayfa-basi {
    margin-bottom: 0;
  }
</style>
