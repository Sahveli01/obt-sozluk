---
/**
 * Arama sayfası. Ana sayfadaki aramayla aynı kodu kullanır
 * (`src/lib/arama-ui.ts`); buradaki fark, her sayfadan bağlantıyla
 * gelinebilen kalıcı bir adres olması.
 *
 * Yollar `data-*` ile geçirilir; `define:vars` script'i satır içine alıp
 * paketlemeyi kapatır ve `minisearch` içe aktarımı tarayıcıda çözülemez.
 */
import { AILELER } from '../data/aileler.ts';
import { KATEGORI_HARITASI } from '../data/kategoriler.ts';
import Temel from '../layouts/Temel.astro';
import { kategoriYolu, siteYolu } from '../lib/yol.ts';
---

<Temel baslik="Ara" aciklama="Sözlükteki terimlerde ara." aktif="ara">
  <div class="giris">
    <h1 class="giris__baslik">Ara</h1>
  </div>

  <form
    class="arama"
    id="arama-formu"
    role="search"
    autocomplete="off"
    data-indeks-url={siteYolu('/search-index.json')}
    data-terim-tabani={siteYolu('/terim')}
  >
    <label class="sadece-ekran-okuyucu" for="arama-girdisi">Terim ara</label>
    <input
      class="arama__girdi"
      id="arama-girdisi"
      name="q"
      type="search"
      placeholder="terim, kısaltma ya da Türkçe karşılık"
      enterkeyhint="search"
      autofocus
    />
    <p class="arama__ipucu">
      Türkçe karakter kullanmana gerek yok — <b>akilli sozlesme</b> yazarsan{' '}
      <b>Akıllı Sözleşme</b>'yi de bulur. <kbd class="tus">/</kbd> tuşu buraya atlar.
    </p>
  </form>

  <p class="arama-durum" id="arama-durumu" role="status" aria-live="polite">
    İndeks yükleniyor…
  </p>

  <ul class="terim-listesi" id="arama-sonuclari" hidden></ul>

  <!-- JavaScript kapalıysa sayfa çıkmaz sokak olmasın. -->
  <noscript>
    <div class="bildirim bildirim--notr">
      <span class="bildirim__baslik">Arama JavaScript gerektiriyor.</span>
      <span>Kategorilerden göz atabilirsin:</span>
      <ul class="noscript-kategoriler">
        {
          AILELER.flatMap((aile) =>
            aile.kategoriler.map((slug) => (
              <li>
                <a href={kategoriYolu(slug)}>{KATEGORI_HARITASI.get(slug)!.ad}</a>
              </li>
            )),
          )
        }
      </ul>
    </div>
  </noscript>
</Temel>

<script>
  import { aramayiBagla, kisayolBagla } from '../lib/arama-ui.ts';

  const form = document.querySelector<HTMLFormElement>('#arama-formu');
  const girdi = document.querySelector<HTMLInputElement>('#arama-girdisi');
  const durum = document.querySelector<HTMLElement>('#arama-durumu');
  const sonuclar = document.querySelector<HTMLElement>('#arama-sonuclari');

  if (form && girdi && durum && sonuclar) {
    aramayiBagla({ form, girdi, durum, sonuclar });
    kisayolBagla(girdi);
  }
</script>
