---
import { getCollection } from 'astro:content';

import Temel from '../../layouts/Temel.astro';
import { kelimeSay, okumaDakikasi } from '../../lib/okuma.ts';
import { SEVIYE_ADLARI } from '../../lib/seviye.ts';
import { siteYolu } from '../../lib/yol.ts';

const terimler = await getCollection('terimler');
const terimHaritasi = new Map(terimler.map((terim) => [terim.id, terim]));

const yollar = (await getCollection('yollar')).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Süre, yoldaki terimlerin gerçek gövde uzunluğundan hesaplanır. */
const satirlar = yollar.map((yol) => {
  const kelime = yol.data.terms.reduce(
    (toplam, slug) => toplam + kelimeSay(terimHaritasi.get(slug)?.body ?? ''),
    0,
  );
  return {
    slug: yol.id,
    baslik: yol.data.title,
    kisa: yol.data.short,
    seviye: yol.data.level,
    terimSayisi: yol.data.terms.length,
    dakika: okumaDakikasi(kelime),
  };
});

const sayi = new Intl.NumberFormat('tr-TR');
---

<Temel
  baslik="Öğrenme yolları"
  aciklama="Sözlüğü baştan sona okumak zorunda değilsin: her yol bir soruya cevap verir ve terimleri öğrenme sırasına dizer."
  aktif="yollar"
>
  <div class="sayfa-basi">
    <h1>Öğrenme yolları</h1>
    <p class="sayfa-basi__giris">
      Sözlüğü baştan sona okumak zorunda değilsin. Her yol bir soruya cevap verir
      ve terimleri öğrenme sırasına dizer: bir terim, kendisini anlamak için
      gereken terimlerden sonra gelir.
    </p>
  </div>

  <ul class="kategori-listesi">
    {
      satirlar.map((yol) => (
        <li class="yol-satiri">
          <a class="kategori-satiri__ad" href={siteYolu(`/yollar/${yol.slug}`)}>
            {yol.baslik}
          </a>
          <span class="yol-satiri__meta">
            <span class="yol-satiri__olcu">
              {sayi.format(yol.terimSayisi)} terim · ~{sayi.format(yol.dakika)} dk
            </span>
            <span class="rozet rozet--seviye">{SEVIYE_ADLARI[yol.seviye]}</span>
          </span>
          <span class="yol-satiri__kisa">{yol.kisa}</span>
        </li>
      ))
    }
  </ul>

  <p class="yol-dipnot">
    Süreler yoldaki terimlerin gerçek uzunluğundan hesaplanır ve terimler
    büyüdükçe kendiliğinden güncellenir.
  </p>
</Temel>

<style>
  /* Terim satırıyla aynı iki satırlı desen:
       1. satır  ad solda, ölçü ve seviye sağda
       2. satır  açıklama, tam genişlikte */
  .yol-satiri {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) var(--space-4);
    min-height: var(--target-min);
    transition: background var(--motion-fast) var(--ease);
  }

  .yol-satiri + .yol-satiri {
    border-top: 1px solid var(--color-line);
  }

  .yol-satiri:hover {
    background: var(--color-surface-sunken);
  }

  .yol-satiri__meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    justify-self: end;
  }

  .yol-satiri__olcu {
    font-size: var(--text-meta);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Terim satırındaki tanımla aynı gerekçe: tek cümle, --measure-wide. */
  .yol-satiri__kisa {
    grid-column: 1 / -1;
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
    max-width: var(--measure-wide);
    text-wrap: pretty;
  }

  .yol-dipnot {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    max-width: var(--measure);
  }

  /* Dar ekranda ölçü ve seviye ada sığmaz; kendi satırına iner. */
  @media (max-width: 47.999rem) {
    .yol-satiri {
      grid-template-columns: 1fr;
    }

    .yol-satiri__meta {
      justify-self: start;
    }
  }
</style>
