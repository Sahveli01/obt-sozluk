---
/**
 * Tüm sayfaların iskeleti.
 *
 * Tasarım yönü DESIGN.md, ürün kimliği CLAUDE.md. Buradaki hiçbir değer
 * sabit değil; hepsi src/styles/tokens.css üzerinden gelir.
 */
import '../styles/global.css';

import { SITE } from '../config.ts';
import { siteYolu } from '../lib/yol.ts';

interface Props {
  baslik: string;
  aciklama?: string;
  /**
   * Arama motorlarına "bu sayfayı dizine alma" der.
   * Yazılmamış (stub) terim sayfalarında açılır: içeriği henüz yok, arama
   * sonucunda çıkması hem okuru hem sözlüğü yanıltır.
   */
  noindex?: boolean;
}

const { baslik, aciklama = SITE.description, noindex = false } = Astro.props;
const tamBaslik = baslik === SITE.name ? SITE.name : `${baslik} — ${SITE.name}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={siteYolu('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="sadece-ekran-okuyucu" href="#icerik">İçeriğe geç</a>

    <header class="site-ust">
      <div class="kabuk">
        <a class="site-ust__ad" href={siteYolu('/')}>{SITE.name}</a>
        <nav class="site-ust__nav" aria-label="Site">
          <a href={siteYolu('/')}>Kategoriler</a>
          <a href={siteYolu('/ara')}>Ara</a>
        </nav>
      </div>
    </header>

    <main class="icerik" id="icerik">
      <div class="kabuk">
        <slot />
      </div>
    </main>

    <footer class="site-alt">
      <div class="kabuk">
        <p>{SITE.description}</p>
      </div>
    </footer>
  </body>
</html>
