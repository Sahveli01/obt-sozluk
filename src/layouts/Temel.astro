---
/**
 * Tüm sayfaların iskeleti.
 *
 * Tasarım yönü DESIGN.md, ürün kimliği CLAUDE.md. Buradaki hiçbir değer
 * sabit değil; hepsi src/styles/tokens.css üzerinden gelir.
 */
import '../styles/global.css';

import Isaret from '../components/Isaret.astro';
import TemaSecici from '../components/TemaSecici.astro';
import { SITE } from '../config.ts';
import { siteYolu } from '../lib/yol.ts';

interface Props {
  baslik: string;
  aciklama?: string;
  /**
   * Arama motorlarına "bu sayfayı dizine alma" der.
   * Yazılmamış (stub) terim sayfalarında açılır: içeriği henüz yok, arama
   * sonucunda çıkması hem okuru hem sözlüğü yanıltır.
   */
  noindex?: boolean;
  /** Başlıktaki hangi bağlantının `aria-current` alacağı. */
  aktif?: 'kategoriler' | 'ara';
}

const {
  baslik,
  aciklama = SITE.description,
  noindex = false,
  aktif,
} = Astro.props;

const tamBaslik = baslik === SITE.name ? SITE.name : `${baslik} — ${SITE.name}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={siteYolu('/favicon.svg')} type="image/svg+xml" />
    {/*
      Tema, boyamadan önce uygulanmalı; yoksa koyu tema seçen okur her
      sayfada bir kare beyaz görür. Bu yüzden satır içi ve senkron.
    */}
    <script is:inline>
      try {
        var t = localStorage.getItem('tema');
        if (t === 'light' || t === 'dark') {
          document.documentElement.setAttribute('data-theme', t);
        }
      } catch (e) {
        /* Gizli sekmede erişilemeyebilir; sistem teması kalır. */
      }
    </script>
  </head>
  <body>
    <a class="atla" href="#icerik">İçeriğe geç</a>

    <header class="site-ust">
      <div class="kabuk site-ust__ic">
        <a class="marka" href={siteYolu('/')}>
          <Isaret yon="sol" />
          <span class="marka__ad marka__ad--uzun">{SITE.name}</span>
          <span class="marka__ad marka__ad--kisa">{SITE.shortName}</span>
          <Isaret yon="sag" />
        </a>

        <div class="site-ust__sag">
          <nav class="site-ust__nav" aria-label="Site">
            <a
              href={siteYolu('/')}
              aria-current={aktif === 'kategoriler' ? 'page' : undefined}
            >
              Kategoriler
            </a>
            <a href={siteYolu('/ara')} aria-current={aktif === 'ara' ? 'page' : undefined}>
              Ara
            </a>
          </nav>
          <TemaSecici />
        </div>
      </div>
    </header>

    <main class="icerik" id="icerik">
      <div class="kabuk">
        <slot />
      </div>
    </main>

    <footer class="site-alt">
      <div class="kabuk">
        <p class="site-alt__metin">
          Topluluk tarafından yazılıyor. Eksik ya da yanlış bulduğun bir terim varsa
          düzeltmesi hoş karşılanır.
        </p>
      </div>
    </footer>
  </body>
</html>
