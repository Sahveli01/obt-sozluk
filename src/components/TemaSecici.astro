---
/**
 * Açık / koyu / sistem tema seçici.
 *
 * Seçim `<html data-theme="...">` üzerinden uygulanır; tokens.css bunu
 * `color-scheme` ile okur ve `light-dark()` iki yarıdan doğru olanı seçer.
 * Tercih localStorage'da durur.
 *
 * Neden `<select>`: telefon başlığında üç düğmeden az yer kaplar, klavye ve
 * ekran okuyucuyla yerleşik olarak çalışır, `color-scheme` sayesinde açılır
 * listesi de temayla uyumlu gelir. Krom geri planda kalmalı.
 *
 * Yanıp sönmeyi önleyen betik `Temel.astro`'nun <head>'inde, bu bileşenden
 * önce çalışır.
 */
---

<div class="tema">
  <label class="sadece-ekran-okuyucu" for="tema-secici">Tema</label>
  <select class="tema__secici" id="tema-secici">
    <option value="system">Sistem</option>
    <option value="light">Açık</option>
    <option value="dark">Koyu</option>
  </select>
</div>

<style>
  /* Tarayıcının varsayılan görünümü kapatılıp token'larla yeniden kuruldu:
     öncesinde kutu sistemin kendi yazı tipi, rengi ve kenarlığıyla
     geliyordu ve başlıktaki tek yabancı öğeydi. Öğe hâlâ gerçek bir
     <select>: sekme, ok tuşları ve ekran okuyucu yerleşik olarak çalışır,
     açılır liste color-scheme sayesinde temayla uyumlu gelir. */
  .tema {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
  }

  .tema__secici {
    appearance: none;
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    line-height: var(--leading-tight);
    color: inherit;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-chip);
    /* Dokunma hedefi gezinme bağlantılarıyla aynı tabanda kalsın.
       Yükseklik min-height'tan geldiği için dikey dolgu yok. */
    min-height: var(--target-min);
    padding-block: 0;
    /* Sağ dolgu, üstüne çizilen çentiğe yer açar. */
    padding-inline: var(--space-3) var(--space-6);
    cursor: pointer;
    transition:
      color var(--motion-fast) var(--ease),
      border-color var(--motion-fast) var(--ease);
  }

  .tema:hover {
    color: var(--color-text);
  }

  .tema__secici:hover {
    border-color: var(--color-line-strong);
  }

  /* Odak halkası global.css'teki :focus-visible kuralından gelir; burada
     yalnızca kenarlık da güçlensin diye ekleniyor. */
  .tema__secici:focus-visible {
    border-color: var(--color-accent);
  }

  /* Açılır liste çentiği: iki kenardan kurulmuş, currentColor ile
     boyanmış bir köşe. Böylece renk metinle birlikte değişir ve
     token dışına çıkan bir değer kalmaz. */
  .tema::after {
    content: '';
    position: absolute;
    inset-inline-end: var(--space-3);
    inline-size: 0.4em;
    block-size: 0.4em;
    border-inline-end: 1px solid currentColor;
    border-block-end: 1px solid currentColor;
    transform: translateY(-0.12em) rotate(45deg);
    pointer-events: none;
  }
</style>

<script>
  import { ANAHTAR, temaUygula, temaOku, type Tema } from '../lib/tema.ts';

  const secici = document.querySelector<HTMLSelectElement>('#tema-secici');
  if (secici) {
    secici.value = temaOku();

    secici.addEventListener('change', () => {
      const deger = secici.value as Tema;
      temaUygula(deger);
      try {
        if (deger === 'system') localStorage.removeItem(ANAHTAR);
        else localStorage.setItem(ANAHTAR, deger);
      } catch {
        // Gizli sekmede localStorage yazılamayabilir; tema yine de uygulanır.
      }
    });
  }
</script>
